# Files NOT published by the Worker. Same format as .gitignore.
# Everything else in the repository root becomes a public URL.

# tooling and local state
.git
.github
.claude
.wrangler
node_modules
.DS_Store
__pycache__

# the Worker, its config and this file
worker/
functions/
wrangler.jsonc
.assetsignore
.gitignore

# notes, scratch and analytics
tasks.md
analytics/
prompts/
.recovered/

# worksheet build tooling (the PDFs and their HTML stay public)
worksheets/*.py
worksheets/*.sh
worksheets/calibrate_*.html
worksheets/README.md
worksheets/data/
