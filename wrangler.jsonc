{
  // BHASHASETU on Cloudflare Workers.
  // "name" must match the project name you give the Worker in the Cloudflare dashboard.
  "name": "bhashasetu",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    // The site lives at the repository root. Files that must not be published
    // (generators, notes, the Worker code itself) are listed in .assetsignore.
    "directory": "./",
    "binding": "ASSETS",
    // Send every request through worker/index.js so each visit can be logged.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhashasetu_analytics",
      // Paste the Database ID from Storage & databases > D1 > bhashasetu_analytics.
      "database_id": "PASTE-DATABASE-ID-HERE"
    }
  ]
}
