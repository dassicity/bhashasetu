 "sent1": [
  [
   "میرا نام رام ہے۔",
   "আমার নাম রাম।"
  ],
  [
   "یہ میرا گھر ہے۔",
   "এটা আমার ঘর।"
  ],
  [
   "میں پانی پیتا ہوں۔",
   "আমি জল খাই।"
  ],
  [
   "وہ روٹی کھاتا ہے۔",
   "সে রুটি খায়।"
  ],
  [
   "تم کہاں ہو؟",
   "তুমি কোথায়?"
  ],
  [
   "میں گھر جاتا ہوں۔",
   "আমি ঘরে যাই।"
  ],
  [
   "یہ پھول لال ہے۔",
   "এই ফুল লাল।"
  ],
  [
   "میری ماں آتی ہے۔",
   "আমার মা আসেন।"
  ],
