 "sent1": [
  [
   "என் பெயர் ராம்.",
   "আমার নাম রাম।"
  ],
  [
   "இது என் வீடு.",
   "এটা আমার বাড়ি।"
  ],
  [
   "நான் தண்ணீர் குடிக்கிறேன்.",
   "আমি জল খাই।"
  ],
  [
   "அவன் சாதம் சாப்பிடுகிறான்.",
   "সে ভাত খায়।"
  ],
  [
   "நீ எங்கே இருக்கிறாய்?",
   "তুমি কোথায়?"
  ],
  [
   "நான் வீட்டுக்கு போகிறேன்.",
   "আমি বাড়ি যাই।"
  ],
  [
   "இந்த பூ சிவப்பு.",
   "এই ফুল লাল।"
  ],
  [
   "என் அம்மா வருகிறாள்.",
   "আমার মা আসেন।"
  ],
  [
   "அவன் என் அண்ணா.",
   "সে আমার দাদা।"
  ],
  [
   "உங்கள் பெயர் என்ன?",
   "আপনার নাম কী?"
  ],
  [
   "பால் சூடாக இருக்கு.",
   "দুধ গরম।"
  ],
  [
   "அவன் வரவில்லை.",
   "সে আসে না।"
  ],
  [
   "எனக்கு தண்ணீர் கொடு.",
   "আমাকে জল দাও।"
  ],
  [
   "இங்கே வா.",
   "এখানে এসো।"
  ],
  [
   "அங்கே போகாதே.",
   "ওখানে যেও না।"
  ],
  [
   "எனக்கு இரண்டு அண்ணா.",
   "আমার দুই দাদা।"
  ],
  [
   "நாங்கள் காலையில் வருகிறோம்.",
   "আমরা সকালে আসি।"
  ],
  [
   "நீயும் வா.",
   "তুমিও এসো।"
  ],
  [
   "என் கை சின்னது.",
   "আমার হাত ছোট।"
  ],
  [
   "தண்ணீர் குளிராக இருக்கு.",
   "জল ঠান্ডা।"
  ],
  [
   "பையன் தூங்குகிறான்.",
   "ছেলে ঘুমোয়।"
  ],
  [
   "இன்று இரவு.",
   "আজ রাত।"
  ],
  [
   "அவள் பாட்டு பாடுகிறாள்.",
   "সে গান গায়।"
  ],
  [
   "நான் தமிழ் கற்கிறேன்.",
   "আমি তামিল শিখি।"
  ],
  [
   "இந்த வீடு புதிது.",
   "এই বাড়ি নতুন।"
  ],
  [
   "காற்று குளிராக இருக்கு.",
   "হাওয়া ঠান্ডা।"
  ],
  [
